# =============================================
# AutoBiz AI — Environment Variables
# Copy this file to `.env` and fill in values.
# NEVER commit the real `.env` file to git.
# =============================================

# --- Database ---
# Local dev: leave empty -> SQLite (autobiz.db)
# Production (Railway/Postgres): set the DATABASE_URL Railway provides
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Security ---
# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Super Admin "God Mode" key (backend/admin.py)
SUPER_ADMIN_KEY=krishnabh_god_mode_2024_secret

# --- App ---
# Public base URL used for links in WhatsApp messages & QR codes
# Local: http://127.0.0.1:8000  |  Production: https://your-app.up.railway.app
SITE_BASE_URL=http://127.0.0.1:8000

# Comma-separated allowed CORS origins. "*" = allow all (dev only)
ALLOWED_ORIGINS=*

# --- WhatsApp Cloud API (Meta) ---
# Leave empty to run in simulated/test mode (no real messages sent)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- AI (optional) ---
# Gemini API key for the AI assistant — leave empty for rule-based fallback
GEMINI_API_KEY=

# --- Environment ---
# Set to "production" on Railway
ENVIRONMENT=development
# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
